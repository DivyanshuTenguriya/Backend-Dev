<!DOCTYPE html>
<html>
<head>
  <title>Employees</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #eef1f5;
      margin: 0;
      padding: 0;
    }

    .container {
      width: 95%;
      margin: 30px auto;
    }

    h2 {
      margin-bottom: 20px;
      color: #333;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .add-btn {
      background: #7cb518;
      color: white;
      padding: 10px 16px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: bold;
    }

    .add-btn:hover {
      background: #6aa10f;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    thead {
      background: #4f5d6b;
      color: white;
    }

    th, td {
      padding: 14px;
      text-align: center;
      font-size: 14px;
    }

    tbody tr {
      border-bottom: 1px solid #eee;
    }

    tbody tr:hover {
      background: #f7f9fc;
    }

    .action-btn {
      border: none;
      background: none;
      cursor: pointer;
      font-size: 14px;
      margin: 0 4px;
      font-weight: bold;
    }

    .edit {
      color: #2563eb;
    }

    .delete {
      color: #dc2626;
    }

    form {
      display: inline;
    }
  </style>
</head>

<body>

<div class="container">

  <div class="top-bar">
    <h2>Employee Details</h2>
    <a href="/employees/add" class="add-btn">+ Add Employee</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Gender</th>
        <th>Department</th>
        <th>Salary</th>
        <th>Joining Date</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
  <% employees.forEach(emp => { %>
    <tr>
      <td><%= emp.name %></td>

      <!-- You don't have gender in data -->
      <td><%= emp.gender%></td>

      <td><%= emp.dept %></td>

      <td>₹ <%= emp.basic_sal %></td>

      <td>
  <%= new Date(emp.date).toLocaleDateString('en-IN') %>
</td>


      <td>
        <a href="/employees/edit/<%= emp.id %>" class="action-btn edit">
  Edit
</a>
        <form action="http://localhost:3000/employees/<%= emp.id %>?_method=DELETE" method="POST">
          <button class="action-btn delete">Delete</button>
        </form>
        <a href="/employees/payroll/<%= emp.id %>" class="action-btn edit">
          Payroll
        </a>
      </td>
    </tr>
  <% }) %>
</tbody>

  </table>

</div>

</body>
</html>
